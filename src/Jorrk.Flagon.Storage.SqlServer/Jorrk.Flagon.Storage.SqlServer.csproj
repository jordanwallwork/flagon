<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Jorrk.Flagon.Storage.SqlServer</PackageId>
    <Description>SQL Server storage for Flagon feature flags: raw ADO.NET (Microsoft.Data.SqlClient), embedded versioned migrations, no EF Core.</Description>
    <RootNamespace>Jorrk.Flagon.Storage.SqlServer</RootNamespace>
    <PackageTags>$(PackageTags);sqlserver;mssql</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <!-- Lift Microsoft.Data.SqlClient's transitive System.Security.Cryptography.Pkcs above versions with known advisories. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" VersionOverride="10.0.13" Condition="'$(TargetFramework)' != 'net8.0'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Jorrk.Flagon\Jorrk.Flagon.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Connection-string-or-name resolution shared by every storage package. -->
    <Compile Include="..\Shared\ConnectionStringResolver.cs" Link="Internal\ConnectionStringResolver.cs" />
    <Compile Include="..\Shared\ReconnectBackoff.cs" Link="Internal\ReconnectBackoff.cs" />
    <Compile Include="..\Shared\ListenerRuns.cs" Link="Internal\ListenerRuns.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Jorrk.Flagon.Storage.SqlServer.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" LogicalName="Jorrk.Flagon.Storage.SqlServer.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
