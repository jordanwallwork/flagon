<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Jorrk.Flagon.Testing</PackageId>
    <Description>Test support for code that uses Flagon: a standalone IFlagon running the real engine over an in-memory store, with synchronous flag setup. Works with any test framework.</Description>
    <RootNamespace>Flagon.Testing</RootNamespace>
    <PackageTags>$(PackageTags);testing</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- The standalone TestFlagon builds its own service provider from AddFlagon's registrations. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <!-- No test framework, ASP.NET Core or fake clock, so it works with any of them. -->
    <ProjectReference Include="..\Flagon\Flagon.csproj" />
  </ItemGroup>
</Project>
