<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Spike B (#23): a targeting compiler backed by json-everything's JsonLogic. Kept in its own project so it can be
    deleted whole if the own-compiler spike (#22) wins (#24). Not shipped.
  -->
  <PropertyGroup>
    <RootNamespace>Flagon.Targeting.JsonEverything</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonLogic" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Flagon\Flagon.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Flagon.Tests" />
  </ItemGroup>
</Project>
